{
  "rules": {
    ".read": false,
    ".write": false,
    "wheelOfChance": {
      ".read": "auth != null",
      "teamNames": {
        "$key": {
          ".write": "auth != null && (!data.exists() || !newData.exists() || data.val() === newData.val())",
          ".validate": "newData.isString() && $key.length <= 200 && newData.parent().parent().child('teams').child(newData.val()).exists()"
        }
      },
      "teams": {
        "$teamId": {
          ".write": "auth != null && ((!data.exists() && newData.exists()) || (!newData.exists() && data.child('deletedAt').isNumber()))",
          ".validate": "$teamId.matches(/^[a-z0-9]{12}$/) && newData.hasChildren(['name', 'createdAt'])",
          "name": {
            ".write": "auth != null && data.exists() && !data.parent().child('deletedAt').exists()",
            ".validate": "newData.isString() && newData.val().length >= 1 && newData.val().length <= 50"
          },
          "createdAt": {
            ".validate": "newData.isNumber() && ((data.exists() && newData.val() === data.val()) || (!data.exists() && newData.val() === now))"
          },
          "deletedAt": {
            ".write": "auth != null && data.parent().exists()",
            ".validate": "newData.isNumber() && newData.val() === now"
          },
          "members": {
            "$memberId": {
              ".write": "auth != null && data.parent().parent().exists() && !data.parent().parent().child('deletedAt').exists()",
              ".validate": "$memberId.matches(/^[a-z0-9]{12}$/) && newData.hasChildren(['name', 'withdrawn', 'createdAt'])",
              "name": {
                ".validate": "newData.isString() && newData.val().length >= 1 && newData.val().length <= 50"
              },
              "withdrawn": {
                ".validate": "newData.isBoolean()"
              },
              "createdAt": {
                ".validate": "newData.isNumber() && ((data.exists() && newData.val() === data.val()) || (!data.exists() && newData.val() === now))"
              },
              "$other": {
                ".validate": false
              }
            }
          },
          "memberNames": {
            "$key": {
              ".write": "auth != null && data.parent().parent().exists() && !data.parent().parent().child('deletedAt').exists() && (!data.exists() || !newData.exists() || data.val() === newData.val())",
              ".validate": "newData.isString() && $key.length <= 200 && newData.parent().parent().child('members').child(newData.val()).exists()"
            }
          },
          "$other": {
            ".validate": false
          }
        }
      },
      "$other": {
        ".validate": false
      }
    }
  }
}
